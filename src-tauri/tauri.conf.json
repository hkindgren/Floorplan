{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Floorplan",
  "version": "1.1.0",
  "identifier": "net.kindgren.floorplan",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Floorplan",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Planritningar för foto- och filminspelningar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["floorplan", "setplan"],
        "name": "Floorplan-ritning",
        "description": "Floorplan-ritning",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-floorplan+json",
        "contentTypes": ["net.kindgren.floorplan.drawing"],
        "exportedType": {
          "identifier": "net.kindgren.floorplan.drawing",
          "conformsTo": ["public.json", "public.data", "public.content"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
